# Copy to .env (never committed) or export in your shell. Scripts fail fast
# at startup, naming the missing variable, if a required one is absent.

# OpenAlex polite pool. Your contact email; sent as mailto= on every request.
OPENALEX_MAILTO=

# Crossref polite pool. Your contact email; sent as mailto= on every request.
CROSSREF_MAILTO=

# NCBI E-utilities key, raises the rate limit from 3 to 10 req/s.
# Get one at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Dimensions DSL API key, from the Dimensions web app (My account > API).
DIMENSIONS_API_KEY=

# Local llama-server used for first-pass candidate proposals (Phase 0
# labelling only; never a source of gold labels). Base URL, no path.
LLAMA_SERVER_URL=http://127.0.0.1:8080
